NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Existing projects may use NEXT_PUBLIC_MAPBOX_TOKEN instead.
# Never add a service-role key to NEXT_PUBLIC_* variables.

# Production canonical HTTPS origin, without a trailing slash (server-only).
# Leave empty for local development. Set in Netlify Functions environment.
APP_ORIGIN=

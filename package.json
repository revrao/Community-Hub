{
  "name": "communityhub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check:services": "node scripts/check-services.mjs",
    "test:database": "node scripts/test-database.mjs",
    "test:logic": "node --experimental-strip-types --test tests/*.test.ts",
    "test": "npm run test:database && npm run test:logic",
    "test:hosted": "node scripts/test-hosted.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "mapbox-gl": "^3.33.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
